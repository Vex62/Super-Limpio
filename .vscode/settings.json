{
  "python.defaultInterpreterPath": "${workspaceFolder}/runtime/python/python.exe",
  "python.analysis.extraPaths": ["${workspaceFolder}/app"],
  "python.testing.unittestEnabled": true,
  "python.testing.unittestArgs": ["-v", "-s", "./tests", "-p", "test_*.py"],
  "terminal.integrated.env.windows": {
    "PYTHONPYCACHEPREFIX": "${workspaceFolder}\\runtime\\_pycache",
    "PATH": "${workspaceFolder}\\runtime\\python;${workspaceFolder}\\runtime\\python\\Scripts;${env:PATH}"
  },
  "files.exclude": { "**/__pycache__": true, "runtime/_descargas": true, "runtime/_pycache": true },
  "files.encoding": "utf8"
}
